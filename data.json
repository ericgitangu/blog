    ]
  }
},
{
  "model": "portfolio.post",
  "pk": 3,
  "fields": {
    "title": "Is the AI race ethical?",
    "slug": "is-the-ai-race-ethical",
    "content": "With several tech giants embattled in an <a href=\"https://dpmd.ai/alphacode-science-li\">#AI</a> race, should this be a concern? Coupled with the diversity misrepresentation shouldn't we be concerned about the potential pitfalls of this powerful technology?, it could be the tipping point... my 2ç 🤔",
    "date": "2023-02-02T23:15:11Z",
    "image": "posts/ai.jpg",
    "author": 1,
    "excerpt": "Technology is amazing! But is the ongoing AI race amongst the tech giants ethical?",
    "tags": [
      1,
      2
    ]
  }
